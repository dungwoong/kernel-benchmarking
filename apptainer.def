Bootstrap: docker
From: pytorch/pytorch:2.8.0-cuda12.9-cudnn9-devel

%files
    requirements.txt /opt/requirements.txt

%environment
    # Rust in the PATH for anyone using the container
    export RUSTUP_HOME=/opt/rust/rustup
    export CARGO_HOME=/opt/rust/cargo
    export PATH=/opt/rust/cargo/bin:$PATH

%post
    set -e
    apt-get update
    # git for build_fa3 submodule, ca-certificates for pip wheel downloads, curl for rustup
    apt-get install -y --no-install-recommends git ca-certificates curl
    pip install --no-cache-dir -r /opt/requirements.txt

    # Rust installed globally into /opt/rust
    export HOME=/home
    export RUSTUP_HOME=/opt/rust/rustup
    export CARGO_HOME=/opt/rust/cargo

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh
    chmod +x /tmp/rustup-init.sh
    /tmp/rustup-init.sh -y --no-modify-path

    # --locked uses Egglog's dependency versions. If re-resolve deps then fails the build
    /opt/rust/cargo/bin/cargo install egglog --locked

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%apprun build_fa3
    set -eu
    unset REQUESTS_CA_BUNDLE CURL_CA_BUNDLE SSL_CERT_FILE PIP_CERT
    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="9.0"
    # skip prebuilt-wheel download, compute nodes have no internet
    export FLASH_ATTENTION_FORCE_BUILD=TRUE

    # the .sif is read-only, install FA3 into a host-side venv
    # --system-site-packages reuses the image's torch and requirements
    if [ ! -d .venv ]; then
        python -m venv --system-site-packages .venv
    fi
    if .venv/bin/python -c "import flash_attn_interface" 2>/dev/null; then
        echo "FA3 already installed, skipping"
        exit 0
    fi
    MAX_JOBS=${MAX_JOBS:-4} .venv/bin/pip install --no-build-isolation ./third_party/flash_attention/hopper
